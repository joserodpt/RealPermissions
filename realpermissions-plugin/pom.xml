<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>joserodpt</groupId>
    <artifactId>realpermissions-plugin</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>joserodpt.realpermissions</groupId>
        <artifactId>realpermissions-parent</artifactId>
        <version>1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <name>realpermissions-plugin</name>

    <build>
        <finalName>realpermissions-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <!-- Lamp names command arguments after the method parameters, so the
                             usage strings depend on these surviving. -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <!-- Replace the original jar rather than leaving an original-...jar beside it -->
                            <outputFile>${project.build.directory}/${project.build.finalName}.jar</outputFile>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <minimizeJar>true</minimizeJar>

                            <!-- Only these. Without an artifactSet the plugin shades every compile
                                 dependency it can reach. -->
                            <artifactSet>
                                <includes>
                                    <include>dev.dejvokep:boosted-yaml</include>
                                    <include>io.github.revxrsal:lamp.common</include>
                                    <include>io.github.revxrsal:lamp.bukkit</include>
                                    <include>io.github.revxrsal:lamp.brigadier</include>
                                    <include>joserodpt:realpermissions-api</include>
                                    <include>com.j256.ormlite:ormlite-core</include>
                                    <include>com.j256.ormlite:ormlite-jdbc</include>
                                    <include>com.github.joserodpt:RealUtils</include>
                                    <include>io.github.projectunified:*</include>
                                    <include>org.bstats:*</include>
                                </includes>
                            </artifactSet>

                            <relocations>
                                <relocation>
                                    <pattern>dev.dejvokep.boostedyaml</pattern>
                                    <shadedPattern>joserodpt.realpermissions.shaded.boostedyaml</shadedPattern>
                                </relocation>
                                <!-- com.mojang.brigadier is deliberately not relocated: those classes
                                     come from the server, we only talk to them. -->
                                <relocation>
                                    <pattern>revxrsal.commands</pattern>
                                    <shadedPattern>joserodpt.realpermissions.shaded.lamp</shadedPattern>
                                </relocation>
                                <!-- Relocated so another plugin shading a different ORMLite cannot
                                     clash with ours. -->
                                <relocation>
                                    <pattern>com.j256.ormlite</pattern>
                                    <shadedPattern>joserodpt.realpermissions.shaded.ormlite</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>joserodpt.realutils</pattern>
                                    <shadedPattern>joserodpt.realpermissions.shaded.realutils</shadedPattern>
                                </relocation>
                                <!-- Also rewrites the manager class names RealUtils loads by name. -->
                                <relocation>
                                    <pattern>io.github.projectunified.unidialog</pattern>
                                    <shadedPattern>joserodpt.realpermissions.shaded.unidialog</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>joserodpt.realpermissions.shaded.bstats</shadedPattern>
                                </relocation>
                            </relocations>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>org/jetbrains/annotations/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- Lamp reaches its Bukkit/Brigadier hooks and parameter types through
                                     reflection and version probing, so minimizeJar can't see they are used. -->
                                <filter>
                                    <artifact>io.github.revxrsal:*</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!-- ORMLite picks its database types and field converters by reflection,
                                     which minimizeJar can't follow. -->
                                <filter>
                                    <artifact>com.j256.ormlite:*</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!-- The dialog managers and RealUtils' Paper text are only ever loaded by name. -->
                                <filter>
                                    <artifact>com.github.joserodpt:RealUtils</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>io.github.projectunified:*</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!-- Our own module: keep all of it rather than let minimizeJar guess.
                                     Other plugins reach its classes through RealPermissionsAPI. -->
                                <filter>
                                    <artifact>joserodpt:realpermissions-api</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.14-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- lamp.bukkit declares lamp.common and lamp.brigadier at runtime scope, which is enough
             for shading but leaves them off the compile classpath, so lamp.common is repeated here.
             lamp.brigadier is only ever reached at runtime, so it does not need the same. -->
        <dependency>
            <groupId>io.github.revxrsal</groupId>
            <artifactId>lamp.common</artifactId>
            <version>${lamp.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.revxrsal</groupId>
            <artifactId>lamp.bukkit</artifactId>
            <version>${lamp.version}</version>
        </dependency>
        <dependency>
            <groupId>joserodpt</groupId>
            <artifactId>realpermissions-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Dialogs, the chat prompt, GUIs and config, shaded and relocated above. It brings
             UniDialog's Spigot and Paper backends with it, picked between at runtime. -->
        <dependency>
            <groupId>com.github.joserodpt</groupId>
            <artifactId>RealUtils</artifactId>
            <version>${realutils.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>${bstats.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.5</version>
            <scope>provided</scope>
        </dependency>
        <!-- Player storage. The JDBC drivers (SQLite, MySQL) come with the server, so only ORMLite
             itself is shaded. -->
        <dependency>
            <groupId>com.j256.ormlite</groupId>
            <artifactId>ormlite-core</artifactId>
            <version>6.1</version>
        </dependency>
        <dependency>
            <groupId>com.j256.ormlite</groupId>
            <artifactId>ormlite-jdbc</artifactId>
            <version>6.1</version>
        </dependency>
    </dependencies>
</project>
